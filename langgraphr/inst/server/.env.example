# Model configuration for the hidden LangGraph server.
#
# These are read from the environment of the R session that starts the server
# (set them with Sys.setenv(...) before lg_connect(), or as OS variables).
# The server is OpenAI-compatible, so any provider with an OpenAI-compatible
# endpoint works (OpenAI, DeepSeek, Moonshot, Ollama, vLLM, ...).

# Model name used by the bundled assistant path.
LANGGRAPHR_MODEL=gpt-4o-mini

# API key. Leave unset to fall back to OPENAI_API_KEY.
LANGGRAPHR_API_KEY=

# Optional base URL for OpenAI-compatible providers, e.g.:
#   http://localhost:11434/v1          (Ollama)
#   https://api.deepseek.com/v1
LANGGRAPHR_BASE_URL=

# Optional: SQLite checkpoint file for durable memory across restarts.
# In R, use lg_use_sqlite("path/to/memory.db") instead of setting this by hand.
# LANGGRAPHR_DB=C:/path/to/memory.db
