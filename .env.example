# Template for project API configuration.
# Copy to projects/<your-app>/.env and fill in real values.
# NEVER commit the real .env file - it is git-ignored on purpose.

# Any OpenAI-compatible provider works (OpenAI, DeepSeek, Moonshot, Ollama, ...)
LANGGRAPHR_MODEL=deepseek-chat
LANGGRAPHR_BASE_URL=https://api.deepseek.com
LANGGRAPHR_API_KEY=sk-your-key-here

# Optional: durable SQLite memory for graphs
# LANGGRAPHR_DB=C:/path/to/memory.db
